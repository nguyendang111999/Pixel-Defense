:root {
    --ink: #1E2033;
    --ink-soft: rgba(30, 32, 51, 0.55);
    --cream: #FFF6E6;
    --cream-dark: #E8D9BF;
    --green: #58D24F;
    --green-dark: #2C9A35;
    --orange: #FF9A2E;
    --orange-dark: #D9661A;
    --blue: #4C8DF6;
    --blue-dark: #2B5FC4;
    --purple: #A160F5;
    --purple-dark: #6E35C2;
    --ice: #4FC3F0;
    --ice-dark: #2186BE;
    --red: #F2453D;
    --red-dark: #B02A25;
    --gold: #FFD23A;
}

.unity-ui-document__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/RobotoBlack.asset");
    color: #FFFFFF;
}

.hidden {
    display: none;
}

.text-outline {
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 6px 0 var(--ink-soft);
}

.body-text {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/InterSemiBold.asset");
}

.big-button {
    min-width: 560px;
    height: 168px;
    margin: 14px 0;
    padding: 0 64px;
    border-radius: 48px;
    border-bottom-width: 16px;
    background-color: var(--green);
    border-color: var(--green-dark);
    font-size: 78px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 5px 0 var(--ink-soft);
    transition-duration: 0.07s;
}

.big-button:active {
    translate: 0 10px;
    border-bottom-width: 6px;
}

.big-button--orange {
    background-color: var(--orange);
    border-color: var(--orange-dark);
}

.big-button--blue {
    background-color: var(--blue);
    border-color: var(--blue-dark);
}

.big-button--small {
    min-width: 330px;
    height: 132px;
    font-size: 58px;
    margin: 10px 12px;
    padding: 0 36px;
    border-radius: 40px;
}

.text-button {
    margin-top: 18px;
    padding: 12px 40px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 50px;
    color: var(--ink);
    opacity: 0.75;
    transition-duration: 0.07s;
}

.text-button:active {
    scale: 0.92 0.92;
}

.round-button {
    width: 124px;
    height: 124px;
    padding: 0;
    margin: 0;
    border-radius: 62px;
    border-bottom-width: 9px;
    background-color: rgba(30, 32, 51, 0.6);
    border-color: rgba(10, 10, 22, 0.6);
    align-items: center;
    justify-content: center;
    transition-duration: 0.07s;
}

.round-button:active {
    translate: 0 6px;
    border-bottom-width: 3px;
}

.round-button__icon {
    width: 78px;
    height: 78px;
}
