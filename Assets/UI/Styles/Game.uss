.vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Textures/Vignette.png");
    -unity-background-image-tint-color: #FF2A1F;
    opacity: 0;
}

.safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---------- HUD ---------- */

.hud {
    flex-grow: 1;
}

.hud-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 26px 34px 0 34px;
}

.level-pill {
    background-color: rgba(20, 22, 42, 0.62);
    border-radius: 44px;
    padding: 8px 46px;
}

.level-pill__text {
    font-size: 56px;
    letter-spacing: 2px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
}

.coin-pill {
    flex-direction: row;
    align-items: center;
    min-width: 124px;
    height: 84px;
    padding: 0 30px 0 12px;
    border-radius: 42px;
    background-color: rgba(20, 22, 42, 0.62);
}

.coin-pill__icon {
    width: 64px;
    height: 64px;
    margin-right: 10px;
}

.coin-pill__text {
    font-size: 46px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
}

.health-row {
    flex-direction: row;
    align-items: center;
    height: 104px;
    margin: 16px 48px 0 30px;
}

.health-row__icon {
    width: 104px;
    height: 104px;
    margin-right: -14px;
}

.health-row__bar {
    flex-grow: 1;
    height: 58px;
}

.booster-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 70px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 30px;
}

.booster-group {
    align-items: center;
}

.booster {
    width: 158px;
    height: 158px;
    margin: 36px 0 0 0;
    padding: 0;
    border-radius: 79px;
    border-bottom-width: 12px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.08s;
}

.booster:active {
    translate: 0 7px;
    border-bottom-width: 5px;
}

.booster--punch {
    scale: 1.18 1.18;
}

.booster--disabled {
    opacity: 0.55;
}

.booster--freeze {
    background-color: var(--ice);
    border-color: var(--ice-dark);
}

.booster--bomb {
    background-color: var(--orange);
    border-color: var(--orange-dark);
}

.booster--slot {
    background-color: var(--purple);
    border-color: var(--purple-dark);
}

.booster__icon {
    width: 96px;
    height: 96px;
}

.booster__badge {
    position: absolute;
    top: -12px;
    right: -14px;
    min-width: 66px;
    height: 66px;
    padding: 0 12px;
    border-radius: 33px;
    border-width: 5px;
    border-color: #FFFFFF;
    background-color: var(--red);
    font-size: 40px;
    -unity-text-align: middle-center;
}

.booster__badge--hidden {
    display: none;
}

.booster__price {
    position: absolute;
    bottom: -30px;
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 16px 0 6px;
    border-radius: 28px;
    border-width: 4px;
    border-color: #FFFFFF;
    background-color: var(--ink);
}

.booster__price--hidden {
    display: none;
}

.booster__price-icon {
    width: 44px;
    height: 44px;
}

.booster__price-text {
    font-size: 34px;
    margin-left: 4px;
}

.booster__label {
    margin-top: 10px;
    font-size: 34px;
    letter-spacing: 1px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
}

/* ---------- Floating feedback ---------- */

.praise {
    position: absolute;
    left: 0;
    right: 0;
    top: 31%;
    -unity-text-align: middle-center;
    font-size: 104px;
    color: var(--gold);
    -unity-text-outline-width: 7px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 9px 0 var(--ink-soft);
    opacity: 0;
    scale: 0.35 0.35;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.praise--show {
    opacity: 1;
    scale: 1 1;
}

.praise--hide {
    opacity: 0;
    translate: 0 -110px;
    transition-duration: 0.45s;
    transition-timing-function: ease-in-cubic;
}

.jam-banner {
    position: absolute;
    left: 110px;
    right: 110px;
    top: 22%;
    align-items: center;
    padding: 20px 26px 24px 26px;
    border-radius: 40px;
    border-bottom-width: 12px;
    background-color: var(--red);
    border-color: var(--red-dark);
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

.jam-banner--hidden {
    opacity: 0;
    scale: 0.4 0.4;
    visibility: hidden;
}

.jam-banner__title {
    font-size: 66px;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--ink);
}

.jam-banner__text {
    font-size: 38px;
    margin-top: 4px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.tutorial {
    position: absolute;
    left: 150px;
    right: 150px;
    bottom: 33%;
    align-items: center;
    padding: 24px 34px 28px 34px;
    border-radius: 44px;
    border-bottom-width: 10px;
    background-color: #FFFFFF;
    border-color: #C9CBE0;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.tutorial--hidden {
    opacity: 0;
    scale: 0.5 0.5;
    visibility: hidden;
}

.tutorial__text {
    font-size: 46px;
    color: var(--ink);
    white-space: normal;
    -unity-text-align: middle-center;
}

.hand {
    position: absolute;
    left: 0;
    top: 0;
    width: 190px;
    height: 190px;
}

.hand--hidden {
    display: none;
}

.hand-ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 150px;
    height: 150px;
    border-radius: 75px;
    border-width: 10px;
    border-color: #FFFFFF;
}

.hand-ring--hidden {
    display: none;
}

/* ---------- Home ---------- */

.home {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    padding: 60px 40px 110px 40px;
    background-color: rgba(14, 15, 32, 0.3);
}

.title {
    white-space: nowrap;
    font-size: 176px;
    -unity-text-outline-width: 9px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 16px 0 var(--ink-soft);
    rotate: -4deg;
}

.title--top {
    color: var(--gold);
}

.title--bottom {
    margin-top: -52px;
    font-size: 138px;
    color: #FFFFFF;
}

.home__tagline {
    margin-top: 22px;
    padding: 12px 36px;
    border-radius: 30px;
    background-color: rgba(20, 22, 42, 0.6);
    font-size: 40px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.home__spacer {
    flex-grow: 1;
}

.home__play {
    align-items: center;
}

.home__level {
    margin-bottom: 16px;
    font-size: 62px;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 6px 0 var(--ink-soft);
}

.home__level--boss {
    color: #FF8A7A;
}

.home__bottom {
    flex-direction: row;
    margin-top: 44px;
}

/* ---------- Popups ---------- */

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 13, 28, 0.62);
    opacity: 0;
    visibility: hidden;
    transition-duration: 0.18s;
}

.overlay--shown {
    opacity: 1;
    visibility: visible;
}

.panel {
    width: 860px;
    align-items: center;
    padding: 120px 50px 56px 50px;
    border-radius: 64px;
    border-width: 8px;
    border-bottom-width: 22px;
    background-color: var(--cream);
    border-color: var(--ink);
    scale: 0.6 0.6;
    transition-duration: 0.34s;
    transition-timing-function: ease-out-back;
}

.overlay--shown > .panel {
    scale: 1 1;
}

.panel__ribbon {
    position: absolute;
    top: -70px;
    left: 70px;
    right: 70px;
    height: 150px;
    align-items: center;
    justify-content: center;
    border-radius: 44px;
    border-width: 8px;
    border-bottom-width: 18px;
    background-color: var(--gold);
    border-color: var(--ink);
}

.panel__ribbon--red {
    background-color: var(--red);
}

.panel__ribbon--blue {
    background-color: var(--blue);
}

.panel__title {
    font-size: 86px;
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 6px 0 var(--ink-soft);
}

.panel__message {
    margin: 18px 10px 26px 10px;
    font-size: 44px;
    color: var(--ink);
    white-space: normal;
    -unity-text-align: middle-center;
}

.panel__actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 24px;
}

.stars {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 10px;
}

.stars--hidden {
    display: none;
}

.star {
    width: 150px;
    height: 150px;
    margin: 0 8px;
    opacity: 0.25;
    scale: 0.75 0.75;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.star--middle {
    width: 190px;
    height: 190px;
    margin-bottom: 26px;
}

.star--earned {
    opacity: 1;
    scale: 1 1;
}

.reward {
    flex-direction: row;
    align-items: center;
    margin-bottom: 26px;
    padding: 8px 40px 8px 16px;
    border-radius: 50px;
    background-color: var(--ink);
}

.reward--hidden {
    display: none;
}

.reward__icon {
    width: 88px;
    height: 88px;
    margin-right: 14px;
}

.reward__text {
    font-size: 64px;
}

.close-button {
    position: absolute;
    top: 40px;
    right: 40px;
    width: 96px;
    height: 96px;
    padding: 0;
    margin: 0;
    border-radius: 48px;
    border-width: 0;
    border-bottom-width: 8px;
    background-color: var(--red);
    border-color: var(--red-dark);
    align-items: center;
    justify-content: center;
}

.close-button:active {
    translate: 0 5px;
    border-bottom-width: 3px;
}

.close-button__icon {
    width: 64px;
    height: 64px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 132px;
    margin: 10px 0;
    padding: 0 30px;
    border-radius: 34px;
    border-width: 0;
    border-bottom-width: 8px;
    background-color: #FFFFFF;
    border-color: var(--cream-dark);
}

.setting-row__icon {
    width: 82px;
    height: 82px;
}

.setting-row__label {
    flex-grow: 1;
    margin-left: 24px;
    font-size: 54px;
    color: var(--ink);
}

.switch {
    width: 150px;
    height: 76px;
    padding: 8px;
    border-radius: 38px;
    background-color: #C7C9DA;
    transition-duration: 0.15s;
}

.switch__knob {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: #FFFFFF;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.setting-row--on > .switch {
    background-color: var(--green);
}

.setting-row--on > .switch > .switch__knob {
    translate: 74px 0;
}
